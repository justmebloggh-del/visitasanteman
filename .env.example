# Copy to .env.local for development. In production set these in Vercel -> Settings -> Environment Variables.
# NEVER commit real values. See docs/ENVIRONMENT_VARIABLES.md.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser: access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---
NEXT_PUBLIC_GA_ID=                 # Google Analytics measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=      # Google Search Console verification token
RESEND_API_KEY=                    # Server only. Enables enquiry email notifications
EMAIL_FROM=                        # e.g. "Visit Lake Bosomtwe <hello@yourdomain>"
ENQUIRY_NOTIFY_EMAIL=              # Where new enquiries are emailed

# --- AI itinerary assistant (optional; off unless both are set) ---
# AI_ASSISTANT_ENABLED=true
# ANTHROPIC_API_KEY=

# --- Online payments (leave off until tested in Paystack test mode; see docs/PAYMENTS.md) ---
# PAYMENTS_ENABLED=true
# PAYSTACK_SECRET_KEY=            # test key first
# SUPABASE_SERVICE_ROLE_KEY=      # server only; used solely by lib/payments
